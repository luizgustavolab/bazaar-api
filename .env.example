# Exemplo de configuração - Copie este arquivo para um novo chamado .env
# e ajuste os valores conforme sua necessidade local.

# Banco de Dados (SQLite via Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Cache e Filas (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Servidor API
PORT=3333
HOST=0.0.0.0
NODE_ENV=development